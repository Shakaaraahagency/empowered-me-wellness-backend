# Copy this file to .env for local development and fill in real values.
# In production (Render), these are set in the Render dashboard's
# Environment Variables screen — this file is never deployed.

FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Render provides this automatically for its managed Postgres add-on.
# Leave blank locally to fall back to a local SQLite file for quick iteration.
DATABASE_URL=

# Comma-separated, no trailing slash
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Stripe — if left blank, /checkout runs a dev-only simulated payment
# instead of crashing. This simulation is hard-disabled when FLASK_ENV=production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Resend — if left blank, all outbound email logs to the console instead
# of sending. Also hard-disabled (logs an error, doesn't silently drop) in production.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@empoweredmewellness.com
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Sentry — if left blank, no error tracking runs. Set this in production.
SENTRY_DSN=

